# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Anthropic API key for the "Ask about Rene" chatbot (src/app/api/ask/route.ts).
# Get one from https://console.anthropic.com after setting up a workspace + spend cap.
ANTHROPIC_API_KEY=

# Set to "true" to disable the chatbot instantly (kill switch) without a redeploy.
CHAT_DISABLED=false

# Resend API key for the contact form (src/app/api/contact/route.ts).
# Get one from https://resend.com after creating an account.
RESEND_API_KEY=

# Where contact form submissions get emailed. Never exposed to the browser.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile — bot check on the chat and contact form.
# Get both from https://dash.cloudflare.com/?to=/:account/turnstile after creating a widget.
# The site key is safe to expose to the browser (hence NEXT_PUBLIC_); the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — per-IP rate limiting on the chat and contact form.
# Get both from https://console.upstash.com after creating a free Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
